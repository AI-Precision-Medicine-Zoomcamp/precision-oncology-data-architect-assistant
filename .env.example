LLM_PROVIDER=groq

# Pick one provider and set the matching key. Leave blank for retrieval-only mode.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

DATA_DIR=/app/data
FHIR_BUNDLES_DIR=/app/data/fhir_examples
CHROMA_PERSIST_DIR=/app/data/chroma_db
